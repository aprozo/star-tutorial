{
  "name": "star-container",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": true,
      "installDockerBuildx": true
    }
  },

  "containerEnv": {
    "DOCKER_API_VERSION": "1.43",
    "HOST_PROJECT_PATH": "${localWorkspaceFolder}"
  },

  "postCreateCommand": "docker pull ghcr.io/star-bnl/star-sw:main-root5-gcc485",

  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/star-tutorial"
}
